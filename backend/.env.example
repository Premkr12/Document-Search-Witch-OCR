# ============================================================
# text-scan-insight — Backend Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your own values.
# In production, ALL variables without a default MUST be set.
# ============================================================

# Server
PORT=5000
NODE_ENV=development          # development | production

# MongoDB
MONGO_URI=mongodb://localhost:27017/text-scan-insight

# JWT — CHANGE THESE in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production

# CORS — set to your frontend URL (the Vite dev server runs on port 8080)
CORS_ORIGIN=http://localhost:8080

# OCR
# 'easyocr' (needs the Python venv in backend/.venv) or 'tesseract' (no Python needed).
# Pages it can't read are read by the other engine automatically.
OCR_ENGINE=easyocr
# Pages read with less than this confidence (%) are read again by the other
# engine, keeping the more confident result. 0 turns this off.
OCR_RETRY_BELOW=50
# Seconds an engine may spend on one page before it's stopped and the page goes
# to the other engine. Each document also gets an overall limit based on its
# page count, after which it's marked as failed so it can't block the queue.
OCR_PAGE_TIMEOUT_SECONDS=180
# How many documents are read at the same time
OCR_CONCURRENCY=2
# Optional: Python interpreter for EasyOCR (defaults to backend/.venv)
# PYTHON_PATH=

# TODO: Cloud Storage (future)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# TODO: Email Service for password recovery (future)
# Use a free service like Brevo (formerly Sendinblue) or Resend.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login_email
# SMTP_PASS=your_brevo_smtp_key
# EMAIL_FROM=noreply@yourdomain.com
